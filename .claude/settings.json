{
  "permissions": {
    "allow": [
      "Bash(sort*)",
      "Bash(sed*)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(cat*)",
      "Bash(ls*)",
      "Bash(echo*)",
      "Bash(mkdir*)",
      "Bash(diff*)",
      "Bash(env*)",
      "Bash(* --version*)",
      "Bash(* -version*)",
      "Bash(* --help*)",
      "Bash(git log*)",
      "Bash(git tag -l*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git cat-file*)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "Bash(jj status*)",
      "Bash(jj new*)",
      "Bash(jj log*)",
      "Bash(jj show*)",
      "Bash(jj diff*)",
      "Bash(jj describe*)",
      "Bash(jj bookmark create*)",
      "Bash(jj squash*)",
      "Bash(jj git init*)",
      "Bash(python3 -m py_compile *)",
      "Bash(mvn*)",
      "Edit(~/.claude/skills/**)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/jj-coauthor-trailer.sh",
            "timeout": 15,
            "statusMessage": "Adding co-author trailer to jj commit message..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/vcs-worktree-create.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude/hooks/vcs-worktree-remove.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "judgement-yields-navigation@jyn-plugins": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "jyn-plugins": {
      "source": {
        "source": "github",
        "repo": "jyn514/dotfiles"
      }
    }
  },
  "theme": "dark",
  "model": "sonnet"
}
