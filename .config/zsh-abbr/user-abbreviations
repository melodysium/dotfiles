#!/bin/zsh

# shell basics
abbr "la"="ls -A"
abbr "ll"="ls -lah"
abbr "cp"="cp -iv"
abbr "mv"="mv -iv"
abbr "mkdir"="mkdir -pv"
abbr "man"="batman"
abbr "abbr-help"="cat $ABBR_USER_ABBREVIATIONS_FILE | fzf"
abbr "e"="$EDITOR"
abbr "e."="$EDITOR $ZDOTDIR"
abbr "e-abbr"="$EDITOR ~/.config/zsh-abbr/user-abbreviations"
abbr "obb"="open-in-bitbucket"

# python
abbr "p3"="python3"
abbr "pip3"="python3 -m pip"

# java
abbr "mcv"="mvn clean verify"
abbr "mcc"="mvn clean compile"

# git
# steal mostly from git oh-my-zsh plugin:
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/git
abbr "g"="git"
abbr "ga"="git add"
abbr "gap"="git add --patch"
abbr "gai"="git add --interactice"
abbr "gau"="git add-untracked"
abbr "gc"="git commit --verbose"
abbr "gca"="git commit --amend --verbose"
abbr "gcane"="git commit --amend --verbose --no-edit"
abbr "gd"="git diff"
abbr "gdc"="git diff --cached"
abbr "gds"="git diff --staged"
abbr "gf"="git fetch"
abbr "gfa"="git fetch --all --tags --prune"
abbr "gfd"="git fetch-default"
abbr "gl"="git log"
abbr "glg"="git log --graph"
abbr "glo"="git log --oneline"
abbr "glp"="git log --stat --patch --ext-diff"
abbr "gm"="git merge"
abbr "gmd"="git merge-default"
abbr "gma"="git merge --abort"
